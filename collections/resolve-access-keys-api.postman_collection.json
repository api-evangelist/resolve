{
  "item": [
    {
      "id": "a58881f6-797b-46cd-8b47-9a167bf2730e",
      "name": "Access Keys",
      "description": {
        "content": "OAuth access keys are created in Merchant Dashboard and can be exchanged for bearer tokens.\n\nUse the `/access-keys/token` endpoint to mint a bearer token from a valid `client_id` and `client_secret`.\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "ed97c98a-3a07-4925-9aa8-bbd098764060",
          "name": "Mint an access token",
          "request": {
            "name": "Mint an access token",
            "description": {
              "content": "Exchange an OAuth access key for a bearer token by providing its `client_id` and `client_secret` in the request body.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "access-keys",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_id\": \"<string>\",\n  \"client_secret\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "24fca9fc-6673-4147-a98d-6a40a611fbfa",
              "name": "Successfully minted bearer token",
              "originalRequest": {
                "url": {
                  "path": [
                    "access-keys",
                    "token"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"access_token\": \"eyJ...\",\n  \"token_type\": \"Bearer\",\n  \"expires_in\": 86400,\n  \"scope\": \"merchant:read merchant:write\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            },
