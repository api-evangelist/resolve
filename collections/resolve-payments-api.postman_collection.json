  "item": [
    {
      "id": "a5459181-3007-485f-819f-7b650037c3fa",
      "name": "Payments",
      "description": {
        "content": "A payment represents a transaction where a customer pays towards their invoices. When a payment is made to Resolve, the customer's available credit balance is increased by the amount of the payment. Payments can be made via various methods including ACH, credit card, check, or wire transfer. Each payment can be applied to one or more invoices.\n",
        "type": "text/plain"
      },
