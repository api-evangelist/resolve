{
  "opencollection": "1.0.0",
  "info": {
    "name": "Resolve API Reference Access Keys API",
    "version": "V5"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Access Keys",
        "type": "folder"
      },
      "items": [
        {
          "info": {
