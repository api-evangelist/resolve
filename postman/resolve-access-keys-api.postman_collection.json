          "item": [
            {
              "name": "Mint an access token",
              "id": "1fd47fe3-2920-42d7-b349-805c2c1682b5",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"client_id\": \"<string>\",\n  \"client_secret\": \"<string>\"\n}",
                  "options": {
                    "raw": {
                      "headerFamily": "json",
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/access-keys/token",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "access-keys",
                    "token"
                  ]
                },
                "description": "Exchange an OAuth access key for a bearer token by providing its `client_id` and `client_secret` in the request body.\n"
              },
              "response": [
